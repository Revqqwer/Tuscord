# --- Tuscord ortam değişkenleri ---
# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` asla depoya girmez.

NODE_ENV=development

# --- Sunucu ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Snowflake worker kimliği (0-1023). Her API/gateway sürecine FARKLI bir değer ver.
SNOWFLAKE_WORKER_ID=1

# --- Veritabanı ---
DATABASE_URL=postgres://tuscord:tuscord@localhost:5432/tuscord
REDIS_URL=redis://localhost:6379

# --- Oturum ---
# openssl rand -hex 32  (veya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=degistir_bunu_32_bayt_hex
SESSION_TTL_DAYS=30
COOKIE_DOMAIN=localhost
# production'da true (HTTPS zorunlu)
COOKIE_SECURE=false

# Virgülle ayrılmış IP listesi — bu IP'ler için hız sınırı (login/register/
# mesaj vb.) UYGULANMAZ. Kendi IP'ni test amaçlı ekleyebilirsin:
#   curl -s https://api.ipify.org
# YAYINA ÇIKMADAN boşalt — brute-force korumasını devre dışı bırakır.
RATE_LIMIT_TRUSTED_IPS=

# --- Cloudflare R2 (ekler, avatarlar) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tuscord-media
R2_PUBLIC_BASE_URL=

# --- E-posta (doğrulama, parola sıfırlama) ---
# Amazon SES SMTP. Konsol → SES → SMTP ayarları → SMTP kimlik bilgisi oluştur.
#   SMTP_HOST=email-smtp.<bölge>.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=<SES SMTP kullanıcı adı — IAM erişim anahtarı DEĞİL, SES'e özel>
#   SMTP_PASS=<SES SMTP parolası>
# Boş bırakılırsa e-postalar konsola yazılır (yalnızca geliştirme).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gönderen adresi/alan adı SES'te DOĞRULANMIŞ olmalı, yoksa gönderim
# reddedilir. Hesap "sandbox" modundaysa yalnızca doğrulanmış ALICI
# adreslerine gönderilebilir — üretime çıkmadan "production access" iste.
# SPF/DKIM/DMARC kaydı da tamamlanmalı.
MAIL_FROM="Tuscord <noreply@tuscord.example>"

# --- Görsel / CSAM taraması (spec Bölüm 8) ---
# 'none': tarama yok — YAYINA ÇIKMADAN kapatılmalı (hukuki).
# 'webhook': yüklenen her görsel aşağıdaki uca gönderilir, karar beklenir.
#   Uç {"verdict":"clean"} veya {"verdict":"flagged"} dönmeli.
#   PhotoDNA / Thorn Safer / Hive gibi bir servisin önüne konur.
# Ayrıca: domain Cloudflare'deyse zone panelinden CSAM Scanning Tool ayrı
# etkinleştirilebilir (pasif, kod gerektirmez) — ikisi birlikte kullanılabilir.
IMAGE_SCAN_PROVIDER=none
IMAGE_SCAN_WEBHOOK_URL=
IMAGE_SCAN_WEBHOOK_TOKEN=
IMAGE_SCAN_TIMEOUT_MS=8000
# Tarama servisi çökerse: open = içeriği geçir+incelemeye al, closed = engelle.
IMAGE_SCAN_FAIL_MODE=open

# --- LiveKit (self-host, ses/ekran paylaşımı SFU) ---
# docker/compose.livekit.yml servisleri bunları kullanır. Anahtarı üretmek için:
#   node -e "console.log('API'+require('crypto').randomBytes(6).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# İstemcinin bağlanacağı adres — bkz. Caddyfile.livekit (ayrı, doğrudan TLS).
LIVEKIT_URL=wss://livekit.tuscord.example

# --- Gelen destek maili (Cloudflare Email Worker) ---
# cloudflare-worker/inbound-email/ — aynı değer worker'ın kendi secret'ıyla eşleşmeli.
INBOUND_EMAIL_SECRET=

# --- Uyum / hukuki (Türkiye'de barındırma) ---
# 5651 yer sağlayıcı: trafik bilgisi saklama süresi (gün). Yasal asgari 1 yıl.
TRAFFIC_LOG_RETENTION_DAYS=365
# KVKK: içerik dışı kişisel veri saklama üst sınırı
ABUSE_CONTACT_EMAIL=abuse@tuscord.example
