{
  "name": "@tuscord/desktop",
  "private": true,
  "version": "0.1.6",
  "description": "Tuscord masaüstü uygulaması — tuscord.com'u yükleyen ince bir Electron kabuğu.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:store": "electron-builder --win appx -c.extraMetadata.version=1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.tuscord.desktop",
    "productName": "Tuscord",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "picker.html",
      "picker-preload.js",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuscord"
    },
    "appx": {
      "identityName": "3NFNANS.Tuscord",
      "publisher": "CN=C6B18975-C8E2-4F88-A7AF-208A5A8B4D60",
      "publisherDisplayName": "3NFİNANS",
      "applicationId": "Tuscord",
      "displayName": "Tuscord",
      "backgroundColor": "#0f1115",
      "languages": [
        "tr-TR"
      ]
    }
  }
}
