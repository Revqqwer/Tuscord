# Sunucu imajı. Kök dizinden build edilir (workspace bağımlılıkları için).
FROM node:22-alpine AS build

# argon2 native derleme gerektirir.
RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/web/package.json packages/web/
RUN npm ci --workspace=@tuscord/shared --workspace=@tuscord/server --include-workspace-root

COPY packages/shared packages/shared
COPY packages/server packages/server
RUN npm run build --workspace=@tuscord/shared && npm run build --workspace=@tuscord/server

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/packages/shared/package.json packages/shared/
COPY --from=build /app/packages/server/dist packages/server/dist
COPY --from=build /app/packages/server/package.json packages/server/
COPY --from=build /app/packages/server/drizzle packages/server/drizzle

# @tuscord/shared'ın giriş noktasını dist'e yönlendir.
# Dev'de package.json `main: src/index.ts` (tsx/vite kaynağı okur), ama prod
# imajında TS kaynağı yok — yalnızca derlenmiş dist var. Bu düzeltme olmadan
# çalışma anında `@tuscord/shared` çözülemez ve sunucu ayağa kalkmaz.
RUN node -e "const f='./packages/shared/package.json';const p=require(f);p.main='./dist/index.js';p.types='./dist/index.d.ts';p.exports={'.':'./dist/index.js'};require('fs').writeFileSync(f,JSON.stringify(p,null,2))"

EXPOSE 3001
# Migration'lar deploy adımında ayrıca çalıştırılır (npm run db:migrate),
# uygulama başlangıcında değil: iki kopya aynı anda migrate etmesin.
CMD ["node", "packages/server/dist/index.js"]
